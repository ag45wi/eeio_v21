# Copy this file to .env locally, never commit real credentials.
# These names match src/util_db.py; MySQL host is currently hardcoded localhost.
APP_KEY=REPLACE_WITH_LONG_RANDOM_LOCAL_KEY
DB_USER=REPLACE_WITH_LOCAL_RESEARCH_DB_USER
DB_PASSWORD=REPLACE_WITH_RESEARCH_DB_PASSWORD
DB_NAME=REPLACE_WITH_RESEARCH_DATABASE_NAME
# Required only if the archived Flask app itself is used (not for batch experiments):
MAIL_USERNAME=
MAIL_PASSWORD=
# Feature flag disabled by default:
EEIO_ENABLE_MANUFACTURING_RESEARCH=0
